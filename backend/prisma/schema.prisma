// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  displayName  String?
  bio          String?
  avatarUrl    String?
  /// Persisted so "last active" survives backend restarts and can be shown
  /// after the three-minute online grace window expires.
  lastActiveAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  posts            Post[]
  postLikes        PostLike[]
  comments         Comment[]
  participants     ConversationParticipant[]
  messages         Message[]
  messageHides     MessageHide[]
  messageReactions MessageReaction[]
  deviceTokens     DeviceToken[]
  albumsCreated    Album[]                   @relation("AlbumCreator")
  albumMemberships AlbumMember[]
  albumUploads     AlbumItem[]
}

/// One row per installed device. A push is sent to every token a user has
/// registered, so the same account can stay logged in on more than one
/// device and get notified on all of them.
model DeviceToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Post {
  id        String   @id @default(uuid())
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  imageUrl  String
  caption   String?
  createdAt DateTime @default(now())

  likes    PostLike[]
  comments Comment[]

  @@index([createdAt])
}

model PostLike {
  id        String   @id @default(uuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
}

model Comment {
  id        String   @id @default(uuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime @default(now())

  @@index([postId, createdAt])
}

model Conversation {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime?
  /// All four flags are per-participant, not per-conversation: pinning or
  /// muting a chat only affects how it looks/behaves on your own side.
  pinned         Boolean      @default(false)
  mutedMessages  Boolean      @default(false)
  mutedCalls     Boolean      @default(false)

  @@unique([conversationId, userId])
}

enum MessageType {
  TEXT
  LINK
  IMAGE
  FILE
  CALL
}

enum CallKind {
  AUDIO
  VIDEO
}

enum CallStatus {
  STARTED
  COMPLETED
  MISSED
  DECLINED
}

model Message {
  id                  String       @id @default(uuid())
  conversationId      String
  conversation        Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId            String
  sender              User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  type                MessageType  @default(TEXT)
  text                String?
  // LINK: linkUrl is the shared external URL, linkTitle/linkImageUrl are the
  // fetched oEmbed-style preview.
  // IMAGE: linkImageUrl holds the uploaded image's URL.
  // FILE: linkUrl holds the uploaded file's URL, linkTitle its original
  // filename, fileSize its size in bytes.
  linkUrl             String?
  linkTitle           String?
  linkImageUrl        String?
  fileSize            Int?
  callKind            CallKind?
  callStatus          CallStatus?
  callDurationSeconds Int?
  unsentAt            DateTime?
  replyToId           String?
  replyTo             Message?     @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies             Message[]    @relation("MessageReplies")
  createdAt           DateTime     @default(now())

  hiddenBy  MessageHide[]
  reactions MessageReaction[]

  @@index([conversationId, createdAt])
  @@index([replyToId])
}

/// A personal hide is account-wide: a message removed "for me" stays hidden
/// after refreshing or opening the same account on another device.
model MessageHide {
  id        String   @id @default(uuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([messageId, userId])
  @@index([userId])
}

model MessageReaction {
  id        String   @id @default(uuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([messageId, userId])
  @@index([messageId])
}

/// A shared photo/video vault between two people. Both members see the same
/// album from their own account and either can add to it.
model Album {
  id          String   @id @default(uuid())
  name        String
  createdById String
  createdBy   User     @relation("AlbumCreator", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members AlbumMember[]
  items   AlbumItem[]

  @@index([createdById])
}

model AlbumMember {
  id       String   @id @default(uuid())
  albumId  String
  userId   String
  album    Album    @relation(fields: [albumId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt DateTime @default(now())

  @@unique([albumId, userId])
  @@index([userId])
}

enum AlbumItemType {
  IMAGE
  VIDEO
}

model AlbumItem {
  id           String        @id @default(uuid())
  albumId      String
  uploaderId   String
  album        Album         @relation(fields: [albumId], references: [id], onDelete: Cascade)
  uploader     User          @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  type         AlbumItemType @default(IMAGE)
  url          String
  /// Cloudinary serves a cheap derived thumbnail; falls back to `url` when
  /// the storage backend can't generate one.
  thumbnailUrl String?
  width        Int?
  height       Int?
  caption      String?
  createdAt    DateTime      @default(now())

  @@index([albumId, createdAt])
}
