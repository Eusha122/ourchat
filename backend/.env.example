DATABASE_URL="postgresql://ourchat:ourchat_dev_password@localhost:5433/ourchat?schema=public"

PORT=4000
JWT_ACCESS_SECRET="change_me"
JWT_REFRESH_SECRET="change_me"

# Android in-app update manifest. Increment APP_VERSION_CODE for every APK
# release and point APP_DOWNLOAD_URL at the HTTPS URL where that APK is hosted.
APP_VERSION_CODE=1
APP_DOWNLOAD_URL="https://your-domain.example/downloads/ourchat.apk"
APP_RELEASE_NOTES="Bug fixes and improvements."

# WebRTC relay: configure the same secret in coturn's `static-auth-secret`.
# TURN_URLS accepts a comma-separated list, for example UDP, TCP and TLS.
TURN_SHARED_SECRET="replace_with_a_long_random_secret"
TURN_URLS="turn:turn.your-domain.example:3478?transport=udp,turn:turn.your-domain.example:3478?transport=tcp,turns:turn.your-domain.example:5349?transport=tcp"

# Cloudflare R2 (S3-compatible) - filled in during Phase 2
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""
